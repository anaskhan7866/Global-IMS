DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key
# Database: each machine keeps its own permanent database file OUTSIDE the project folder
#   Windows: %LOCALAPPDATA%\GlobalIMS\global_ims.sqlite3
#   macOS:   ~/Library/Application Support/GlobalIMS/global_ims.sqlite3
# Optional: store the database file somewhere else instead.
# SQLITE_PATH=D:/GlobalIMS/global_ims.sqlite3
# Optional: use a hosted PostgreSQL database instead of the local file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata
